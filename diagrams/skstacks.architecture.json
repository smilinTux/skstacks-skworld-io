  "boundaries": [
    { "kind": "region", "label": "Public: smilinTux/skstacks (framework)", "wraps": ["fw-code", "fw-templates", "fw-tags"] },
    { "kind": "security-group", "label": "Private: your instance repo", "wraps": ["in-framework", "in-envs", "in-secrets"] }
