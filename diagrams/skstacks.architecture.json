  "cards": [
    { "dot": "cyan", "title": "Framework (public)", "items": ["Defines every service with no estate-specific values baked in", "Ships *.example templates only, never a real secret", "Every release is an annotated skstacks-v2.X.Y tag with a CHANGELOG entry"] },
    { "dot": "rose", "title": "Instance (private)", "items": ["Pins the framework as a framework/ submodule at a released tag", "Holds the inventory, per-environment values and encrypted secrets", "Upgrades by bumping the submodule to a newer tag, never by editing framework code in place"] },
